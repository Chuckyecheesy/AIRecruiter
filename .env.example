# Copy to .env and fill in. Never commit .env.

# --- Claude ---
ANTHROPIC_API_KEY=
MODEL_DECIDE=claude-sonnet-5-5
MODEL_DRAFT=claude-sonnet-5-5
MODEL_EVAL=claude-sonnet-5-5

# --- Tool modes: mock | real (per-tool overrides optional) ---
TOOLS_MODE=mock
# PLOID_MODE=
# FIBER_MODE=
# ELEVENLABS_MODE=
# BROWSER_MODE=

# --- Ploid ---
PLOID_API_KEY=
PLOID_BASE_URL=

# --- Fiber ---
FIBER_API_KEY=
FIBER_BASE_URL=

# --- ElevenLabs (voice interview) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_POLL=

# --- Langfuse (tracing; no-op if keys are empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Email safety (leave ALLOW_REAL_EMAIL unset so nothing real is sent) ---
DEMO_INBOX=
ALLOW_REAL_EMAIL=
EMAIL_ALLOWLIST=

# --- Runtime ---
PERSONA_DELAY_S=15
MAX_CONCURRENT_RUNS=4
# JOB_ID=
ADMIN_ENABLED=false
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8000

# --- Dashboard (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# X-Demo-Token header value protecting the deployed instance (optional)
# DEMO_TOKEN=
