# Copy to .env and fill in. Never commit .env.

# --- LLM (Gemini default; Anthropic remains supported) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
MODEL_DECIDE=gemini-2.5-flash
MODEL_DRAFT=gemini-2.5-flash
MODEL_EVAL=gemini-2.5-flash
# real | stub (stub = canned LLM outputs, fully offline)
LLM_MODE=real

# --- Tool modes: mock | real (per-tool overrides optional) ---
TOOLS_MODE=mock
# PLOID_MODE=
# FIBER_MODE=
# ELEVENLABS_MODE=
# BROWSER_MODE=
# Demo resilience flag: make one tool always fail (e.g. fiber)
# FAIL_TOOL=

# --- Ploid ---
PLOID_API_KEY=
PLOID_BASE_URL=

# --- Fiber ---
FIBER_API_KEY=
FIBER_BASE_URL=

# --- ElevenLabs (voice interview) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_POLL=false
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# Mock interview: seconds until the scripted transcript is ready
MOCK_INTERVIEW_DELAY_S=15

# --- Langfuse (tracing; no-op if keys are empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Email safety (leave ALLOW_REAL_EMAIL unset so nothing real is sent) ---
DEMO_INBOX=demo@example.com
ALLOW_REAL_EMAIL=false
# comma-separated
EMAIL_ALLOWLIST=

# --- Runtime ---
PERSONA_DELAY_S=15
MAX_CONCURRENT_RUNS=4
# JOB_ID=
ADMIN_ENABLED=false
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8000

# --- Dashboard (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# X-Demo-Token header value protecting the deployed instance (optional)
# DEMO_TOKEN=
